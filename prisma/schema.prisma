generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model IkuData {
  id        String   @id @default(cuid())
  prodi     String
  fakultas  String
  tahun     Int
  iku1      String?  // JSON string: { jumlahMasuk, lulusTepatWaktu }
  iku2      String?  // JSON string: { bekerjaJumlah, bekerjaBobot, wirausahaJumlah, wirausahaBobot, studiJumlah, sudahBekerjaJumlah, sudahBekerjaBobot, totalResponden }
  iku3      String?  // JSON string: { mahasiswaKegiatan, bobotKegiatan, totalMahasiswa }
  iku5      String?  // JSON string: { jumlahLuaran, totalKerjasama }
  iku7      String?  // JSON string: { jumlahProgramSDG, totalProgram }
  iku9      String?  // JSON string: { pendapatanNonAkademik, totalPendapatan }
  iku12     String?  // JSON string: { dokumenTersedia, skorKomposit }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([prodi, tahun])
}
